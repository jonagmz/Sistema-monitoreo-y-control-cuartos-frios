<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Lecturas -->
        <TextView
            style="@style/Titulo"
            android:text="@string/titulo_lecturas" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/temperatura"
                android:src="@drawable/imgtemp" />

            <TextView
                style="@style/Etiqueta"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/temperatura" />

            <TextView
                android:id="@+id/txtTempAct"
                style="@style/Lectura"
                android:text="@string/nd" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/humedad"
                android:src="@drawable/imghum" />

            <TextView
                style="@style/Etiqueta"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/humedad" />

            <TextView
                android:id="@+id/txtHumAct"
                style="@style/Lectura"
                android:text="@string/nd" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtUbicacion"
            style="@style/Detalle"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:text="@string/nd" />

        <TextView
            android:id="@+id/txtEstado"
            style="@style/Detalle" />

        <TextView
            android:id="@+id/txtAlarmas"
            style="@style/Detalle" />

        <TextView
            android:id="@+id/txtActualizado"
            style="@style/Detalle"
            android:text="@string/sin_datos" />

        <Button
            android:id="@+id/btnPedirLecturas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pedir_lecturas" />

        <!-- Configuración -->
        <TextView
            style="@style/Titulo"
            android:layout_marginTop="24dp"
            android:text="@string/titulo_configuracion" />

        <TextView
            android:id="@+id/txtConfigEquipo"
            style="@style/Detalle" />

        <TextView
            style="@style/Etiqueta"
            android:layout_marginTop="8dp"
            android:text="@string/temperatura_deseada" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editTempMin"
                style="@style/Campo"
                android:hint="@string/minima"
                android:importantForAutofill="no"
                android:inputType="numberSigned" />

            <EditText
                android:id="@+id/editTempMax"
                style="@style/Campo"
                android:hint="@string/maxima"
                android:importantForAutofill="no"
                android:inputType="numberSigned" />
        </LinearLayout>

        <TextView
            style="@style/Etiqueta"
            android:layout_marginTop="8dp"
            android:text="@string/humedad_deseada" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editHumMin"
                style="@style/Campo"
                android:hint="@string/minima"
                android:importantForAutofill="no"
                android:inputType="number" />

            <EditText
                android:id="@+id/editHumMax"
                style="@style/Campo"
                android:hint="@string/maxima"
                android:importantForAutofill="no"
                android:inputType="number" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSistema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/encender_celdas"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnActualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/enviar_configuracion" />

        <!-- Equipo -->
        <TextView
            android:id="@+id/txtNumeroEquipo"
            style="@style/Detalle"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnNumeroEquipo"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cambiar_numero_equipo" />
    </LinearLayout>
</ScrollView>
